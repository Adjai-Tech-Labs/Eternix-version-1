# ETERNIX Configuration
# Copy to .env and fill in real values. .env is never committed.

MODEL_DIR=/path/to/models
DATA_DIR=/path/to/data
HF_CACHE_DIR=/path/to/huggingface-cache

# Llama.cpp
LLAMA_CPP_BIN=/path/to/llama.cpp/bin

# Database
DB_PATH=/path/to/data/eternix.db

# Qdrant
QDRANT_PATH=/path/to/data/qdrant

# API
API_HOST=127.0.0.1
API_PORT=8080

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Features
ENABLE_VISION=true
ENABLE_WEB=true
ENABLE_VOICE=false

# Auth
# "production" requires real secrets and providers (see require_production_secrets).
ETERNIX_AUTH_MODE=development
ETERNIX_AUTH_JWT_KEY=change-me-in-production
ETERNIX_AUTH_SESSION_KEY=change-me-in-production
ETERNIX_AUTH_PAYMENT_PROVIDER=sandbox
ETERNIX_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- Email verification ---
# Delivery provider: "none" | "smtp" | "sendgrid" | "emailjs".
ETERNIX_AUTH_EMAIL_PROVIDER=none

# Verification code lifetime (minutes), attempt limit and
# resend cooldown (seconds). Alternative names
# EMAIL_VERIFICATION_CODE_TTL_MINUTES,
# EMAIL_VERIFICATION_MAX_ATTEMPTS and
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS are also accepted.
ETERNIX_AUTH_OTP_EXPIRY_SECONDS=300
ETERNIX_AUTH_OTP_MAX_ATTEMPTS=5
ETERNIX_AUTH_OTP_REQUEST_COOLDOWN_SECONDS=60

# --- EmailJS delivery (server-side) ---
# Populate all three values from the EmailJS dashboard:
#   Service ID:  https://dashboard.emailjs.com/admin
#   Template ID: https://dashboard.emailjs.com/admin/templates
#   Public key:  account settings (API keys)
# The Template ID is an opaque identifier like "template_abc123".
# It is NOT the template name. Copy it from the template's
# dashboard page. Until ETERNIX_AUTH_EMAILJS_TEMPLATE_ID and
# ETERNIX_AUTH_EMAILJS_PUBLIC_KEY are set, email delivery is
# truthfully reported as not configured.
ETERNIX_AUTH_EMAILJS_SERVICE_ID=service_5i21ybi
ETERNIX_AUTH_EMAILJS_TEMPLATE_ID=template_YOUR_TEMPLATE_ID
ETERNIX_AUTH_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
# Optional: enables higher server-side sending limits.
ETERNIX_AUTH_EMAILJS_PRIVATE_KEY=YOUR_PRIVATE_KEY

# Alternative (unprefixed) names are also accepted:
# EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID,
# EMAILJS_PUBLIC_KEY, EMAILJS_PRIVATE_KEY

# --- SMTP delivery (alternative) ---
# ETERNIX_AUTH_SMTP_HOST=localhost
# ETERNIX_AUTH_SMTP_PORT=587
# ETERNIX_AUTH_SMTP_USERNAME=
# ETERNIX_AUTH_SMTP_PASSWORD=
# ETERNIX_AUTH_SMTP_FROM=noreply@eternix.local

# --- SendGrid delivery (alternative) ---
# ETERNIX_AUTH_SENDGRID_API_KEY=
